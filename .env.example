# Copy to .env (never committed) or set as host secrets. Values are read from the
# environment only; the code never prints them and the logger redacts them.
XAU_TELEGRAM_BOT_TOKEN=
XAU_TELEGRAM_CHAT_ID=
# paper | live   (paper = evaluate + record, no Telegram setup alerts; failure alerts still go out if configured)
XAU_MODE=paper
# Optional: override config file
XAU_CONFIG=config/default.toml
